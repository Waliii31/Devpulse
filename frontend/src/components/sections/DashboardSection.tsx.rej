+// Fetch heatmap data using Deno API for accurate 365-day contributions
+function useHeatmapData(username: string) {
+  return useQuery({
+    queryKey: ['github-contributions', username],
+    queryFn: async () => {
+      try {
+        const res = await fetch(`https://github-contributions-api.deno.dev/${username}.json`)
+        if (!res.ok) throw new Error('Failed to fetch contributions')
+        const data = await res.json()
+        
+        // Convert to grid of intensities (0-4)
+        const grid = data.contributions.map((week: any[]) => 
+          week.map((day: any) => parseInt(day.intensity, 10) || 0)
+        )
+        return { grid, total: data.totalContributions }
+      } catch (err) {
+        // Fallback to empty grid
+        const grid = Array(52).fill(0).map(() => Array(7).fill(0))
+        return { grid, total: 0 }
+      }
+    },
+    staleTime: 1000 * 60 * 60, // Cache for 1 hour
+  })
+}
+
+function getTimeAgo(dateStr: string): string {
+  const now = new Date()
+  const date = new Date(dateStr)
+  const diffMs = now.getTime() - date.getTime()
+  const diffHours = Math.floor(diffMs / (1000 * 60 * 60))
+  if (diffHours < 1) return 'just now'
+  if (diffHours < 24) return `${diffHours}h ago`
+  const diffDays = Math.floor(diffHours / 24)
+  if (diffDays < 7) return `${diffDays}d ago`
+  return `${Math.floor(diffDays / 7)}w ago`
+}
+
+function formatCount(n: number): string {
+  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`
+  return String(n)
+}
+
+function getLanguageColor(lang: string | null | undefined): string {
+  if (!lang) return 'var(--terminal-green)'
+  const l = lang.toLowerCase()
+  const colors: Record<string, string> = {
+    typescript: '#3178c6',
+    javascript: '#f1e05a',
+    python: '#3572A5',
+    html: '#e34c26',
+    css: '#563d7c',
+    java: '#b07219',
+    go: '#00ADD8',
+    rust: '#dea584',
+    ruby: '#701516',
+    shell: '#89e051',
+  }
+  return colors[l] || 'var(--terminal-green)'
+}
+
 export function DashboardSection() {
   const { username = 'octocat' } = useParams()
 
